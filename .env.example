[TEMPLATE]
# Formspree form ID for the waitlist form. Server-side only.
# Copy this file to .env.local and fill in the real value. Never commit a real value.
FORMSPREE_FORM_ID=

# --- Supabase (Phase 2) ---
# Get these from Supabase Dashboard -> Project Settings -> API.
# NEXT_PUBLIC_* values are inlined into the browser bundle at build time and are
# public by design. Data access is protected by row-level security, not by keeping
# these secret. The SERVICE ROLE key is the only secret: server-side only, never
# NEXT_PUBLIC_, never in git or client code.

# Project URL, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Anon (public) key. Safe in the browser; RLS is the boundary.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key. Bypasses RLS. Server-side only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
